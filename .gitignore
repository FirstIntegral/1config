# Runtime archives — never commit (setup replace-backups, residue packets, strays)
backups/

# Python bytecode (verify.sh py_compile smoke test regenerates it)
__pycache__/
*.pyc

# Skills: machine-local tool skills (omarchy, diagnose-crash, vigil) stay untracked;
# on-demand process skills below are tracked in 1config.
skills/*
!skills/systematic-debugging/
!skills/verification-before-completion/
!skills/receiving-code-review/
!skills/requesting-code-review/
!skills/writing-plans/

# Live grok/claude/opencode versions — differ per machine, rewritten by setup/updater
inventory.local.md

# Last dashboard exit: warn/fail lines, or CLEAN. Missing file means no exit yet.
boot-dashboard/close-slip.txt

# This machine's overrides. Upstream never owns them. See local.json.example.
local.json
