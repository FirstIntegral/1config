[Unit]
Description=1config guards: rules symlinks, tool-memory residue
Documentation=file://%h/.agents/SETUP.md

[Service]
Type=oneshot
# One ordered chain. A leading "-" keeps it going when a guard exits non-zero:
# check-links.sh exits 2 while a stray rules file waits for a person.
ExecStart=-%h/cron-jobs/agents-symlink-guard/check-links.sh
ExecStart=-%h/cron-jobs/claude-memory-guard/check-memory.sh
TimeoutStartSec=15min
